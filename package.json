{
	"name": "@dialecte/nsd",
	"version": "0.6.1",
	"description": "Dialecte - NSD (Namespace Definition) sdk",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dialecte/nsd.git"
	},
	"source": "src/v2017A/index.ts",
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		"./v2017A": {
			"types": "./dist/v2017A/index.d.ts",
			"default": "./dist/v2017A/index.js"
		},
		"./v2017A/test": {
			"types": "./dist/v2017A/test.d.ts",
			"default": "./dist/v2017A/test.js"
		}
	},
	"scripts": {
		"//====== BUILD ======//": "",
		"build": "run-p type-check \"build-only {@}\" --",
		"build-only": "tsc -p tsconfig.json && vite build",
		"//====== VITEPRESS ======//": "",
		"doc:dev": "vitepress dev",
		"doc:build": "vitepress build",
		"doc:preview": "vitepress preview",
		"//====== TEST ======//": "",
		"test": "npm run test:node && npm run test:browser",
		"test:node": "vitest run --project node",
		"test:browser": "vitest run --project browser --passWithNoTests",
		"test:browser:all": "vitest run --project browser-all",
		"test:hook": "dialecte gate --hook",
		"//====== CHECK ======//": "",
		"check": "run-p type-check type-check:test type-check:node lint:check format:check",
		"type-check": "tsc -p tsconfig.build.json --noEmit",
		"type-check:test": "tsc -p tsconfig.vitest.json --noEmit",
		"type-check:node": "tsc -p tsconfig.node.json --noEmit",
		"lint:check": "oxlint",
		"lint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"//====== TYPE PERF ======//": "",
		"coverage:gen": "dialecte coverage",
		"type-bench": "npm run coverage:gen && dialecte bench",
		"type-bench:check": "npm run coverage:gen && dialecte bench --check",
		"type-narrowing": "npm run coverage:gen && dialecte narrowing",
		"type-audit": "dialecte audit",
		"//====== HOOKS ======//": "",
		"prepare": "husky"
	},
	"dependencies": {
		"@dialecte/core": "0.10.0"
	},
	"devDependencies": {
		"@dialecte/cli": "0.6.0",
		"@tsconfig/node24": "^24.0.4",
		"@types/node": "^24.12.4",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "^4.1.10",
		"husky": "^9.1.7",
		"jiti": "^2.4.2",
		"npm-run-all2": "^8.0.4",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"playwright": "^1.60.0",
		"tsx": "^4.22.4",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "8.0.16",
		"vite-plugin-dts": "^5.0.2",
		"vitepress": "^2.0.0-alpha.17",
		"vitepress-plugin-llms": "^1.13.2",
		"vitest": "^4.1.10"
	},
	"dialecte": {
		"profile": "contributor",
		"gate": {
			"fast": [
				{
					"name": "check",
					"run": "npm run check"
				},
				{
					"name": "tests",
					"run": "npx vitest run --project node --changed",
					"counts": "tests",
					"changedOnly": true
				}
			],
			"full": [
				{
					"name": "check",
					"run": "npm run check"
				},
				{
					"name": "build",
					"run": "npm run build"
				},
				{
					"name": "tests",
					"run": "npx vitest run --project node",
					"counts": "tests"
				},
				{
					"name": "browser tests",
					"run": "npx vitest run --project browser --passWithNoTests"
				}
			]
		},
		"tdd": {
			"production": [
				"src/v2017A/test"
			]
		}
	}
}
